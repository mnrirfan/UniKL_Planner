[debug] [2026-06-15T17:56:41.662Z] >>> [apiv2][body] POST http://127.0.0.1:9399/v1/projects/unikl-planner-login-info/locations/asia-southeast1/services/uniklplanner:executeGraphql {"operationName":"ListGroupsForCourse","variables":{"courseCode":"FPB49906"},"query":"# ============================================================\r\n# MUTATIONS — what the app WRITES to the database\r\n# Each mutation auto-generates a Kotlin function in the SDK\r\n# ============================================================\r\n\r\n# Enroll the current student in a course (with chosen group)\r\nmutation EnrollCourse($courseCode: String!, $groupId: UUID) @auth(level: PUBLIC) {\r\n  enrollment_insert(data: {\r\n    student: { uid_expr: \"auth.uid\" }\r\n    course: { code: $courseCode }\r\n    group: { id: $groupId }\r\n    status: \"ST\"\r\n  })\r\n}\r\n\r\n# Drop a course (delete the enrollment row)\r\nmutation DropCourse($enrollmentId: UUID!) @auth(level: PUBLIC) {\r\n  enrollment_delete(id: $enrollmentId)\r\n}\r\n\r\n# Update an enrollment's status\r\n# Used when cycling PENDING → ST → PASS in Course Management\r\nmutation UpdateEnrollmentStatus($enrollmentId: UUID!, $newStatus: String!, $credits: Int) @auth(level: PUBLIC) {\r\n  enrollment_update(id: $enrollmentId, data: {\r\n    status: $newStatus\r\n    creditGained: $credits\r\n  })\r\n}\r\n\r\n# Change which group a student is enrolled in (G1 ↔ G2)\r\nmutation ChangeGroup($enrollmentId: UUID!, $newGroupId: UUID!) @auth(level: PUBLIC) {\r\n  enrollment_update(id: $enrollmentId, data: { group: { id: $newGroupId } })\r\n}\r\n\r\n# Add a new study task\r\nmutation AddStudyTask($title: String!, $courseName: String!, $dueDate: String!) @auth(level: PUBLIC) {\r\n  studyTask_insert(data: {\r\n    student: { uid_expr: \"auth.uid\" }\r\n    title: $title\r\n    courseName: $courseName\r\n    dueDate: $dueDate\r\n    isCompleted: false\r\n  })\r\n}\r\n\r\n# Toggle a task's completion status\r\nmutation ToggleTaskCompletion($taskId: UUID!, $isCompleted: Boolean!) @auth(level: PUBLIC) {\r\n  studyTask_update(id: $taskId, data: { isCompleted: $isCompleted })\r\n}\r\n\r\n# Delete a task\r\nmutation DeleteTask($taskId: UUID!) @auth(level: PUBLIC) {\r\n  studyTask_delete(id: $taskId)\r\n}\r\n\r\n# Create or update student profile (called on first login)\r\nmutation UpsertStudentProfile(\r\n  $studentId: String!,\r\n  $name: String!,\r\n  $programme: String!,\r\n  $intake: String!,\r\n  $currentSemester: Int!,\r\n  $totalCreditsRequired: Int!,\r\n  $institute: String!,\r\n  $academicAdvisor: String!,\r\n  $email: String!\r\n) @auth(level: PUBLIC) {\r\n  student_upsert(data: {\r\n    uid_expr: \"auth.uid\"\r\n    studentId: $studentId\r\n    name: $name\r\n    programme: $programme\r\n    intake: $intake\r\n    currentSemester: $currentSemester\r\n    totalCreditsRequired: $totalCreditsRequired\r\n    institute: $institute\r\n    academicAdvisor: $academicAdvisor\r\n    email: $email\r\n  })\r\n}\n# ============================================================\r\n# QUERIES — what the app READS from the database\r\n# Each query auto-generates a Kotlin function in the SDK\r\n# ============================================================\r\n\r\n# Get the current student's profile\r\n# Uses Firebase Auth UID to find which student is logged in\r\nquery GetStudentProfile @auth(level: PUBLIC) {\r\n  student(key: { uid: \"vgA7UHMhF0boinz6BiUoKhCOYY93\" }) {\r\n    uid\r\n    studentId\r\n    name\r\n    programme\r\n    intake\r\n    currentSemester\r\n    totalCreditsRequired\r\n    institute\r\n    academicAdvisor\r\n    email\r\n  }\r\n}\r\n\r\n# Get all courses in the curriculum (everyone can see these)\r\n# Sorted by year, then semester, then course code\r\nquery ListAllCourses @auth(level: PUBLIC) {\r\n  courses(orderBy: [{ year: ASC }, { semester: ASC }, { code: ASC }]) {\r\n    code\r\n    name\r\n    credits\r\n    category\r\n    year\r\n    semester\r\n    prerequisite\r\n    isOptional\r\n  }\r\n}\r\n\r\n# Get all schedule groups for a specific course\r\n# Used when student wants to see G1 vs G2 options\r\nquery ListGroupsForCourse($courseCode: String!) @auth(level: PUBLIC) {\r\n  scheduleGroups(where: { course: { code: { eq: $courseCode } } }) {\r\n    id\r\n    groupCode\r\n    day\r\n    startTime\r\n    endTime\r\n    room\r\n    lecturer\r\n    semesterOffered\r\n    capacity\r\n    enrolled\r\n  }\r\n}\r\n\r\nquery ListAllGroups @auth(level: PUBLIC) {\r\n  scheduleGroups {\r\n    groupCode\r\n    day\r\n    startTime\r\n    endTime\r\n    room\r\n    lecturer\r\n    course {\r\n      code\r\n    }\r\n  }\r\n}\r\n\r\n# Get all of the current student's enrollments\r\n# Returns courses they've completed, are taking, or transferred\r\nquery GetMyEnrollments @auth(level: PUBLIC) {\r\n  enrollments(where: { student: { uid: { eq: \"vgA7UHMhF0boinz6BiUoKhCOYY93\" } } }) {\r\n    id\r\n    status\r\n    creditGained\r\n    semesterTaken\r\n    grade\r\n    course {\r\n      code\r\n      name\r\n      credits\r\n      category\r\n      year\r\n      semester\r\n      prerequisite\r\n      isOptional\r\n    }\r\n    group {\r\n      id\r\n      groupCode\r\n      day\r\n      startTime\r\n      endTime\r\n      room\r\n      lecturer\r\n    }\r\n  }\r\n}\r\n\r\n# Get just this semester's courses (for timetable view)\r\n# Filters to only \"ST\" = currently taking\r\nquery GetCurrentSemesterCourses @auth(level: PUBLIC) {\r\n  enrollments(where: {\r\n    student: { uid: { eq: \"vgA7UHMhF0boinz6BiUoKhCOYY93\" } },\r\n    status: { eq: \"ST\" }\r\n  }) {\r\n    id\r\n    course {\r\n      code\r\n      name\r\n      credits\r\n      category\r\n    }\r\n    group {\r\n      groupCode\r\n      day\r\n      startTime\r\n      endTime\r\n      room\r\n      lecturer\r\n    }\r\n  }\r\n}\r\n\r\n# Get the student's study tasks (assignments / to-do)\r\nquery GetMyTasks @auth(level: PUBLIC) {\r\n  studyTasks(\r\n    where: { student: { uid: { eq: \"vgA7UHMhF0boinz6BiUoKhCOYY93\" } } },\r\n    orderBy: [{ isCompleted: ASC }, { createdAt: DESC }]\r\n  ) {\r\n    id\r\n    title\r\n    courseName\r\n    dueDate\r\n    isCompleted\r\n  }\r\n}\n","extensions":{}}
