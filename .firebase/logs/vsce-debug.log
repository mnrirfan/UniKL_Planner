eedScheduleGroups @auth(level: PUBLIC) {\n  g1: scheduleGroup_insert(data: {\n    course: { code: \"FAB30303\" }\n    groupCode: \"G1\"\n    day: \"Monday\"\n    startTime: \"08:00\"\n    endTime: \"10:00\"\n    room: \"LAB-MFI-1\"\n    lecturer: \"Dr. Azman\"\n    semesterOffered: \"MARCH 2026\"\n  })\n  g2: scheduleGroup_insert(data: {\n    course: { code: \"FAB30303\" }\n    groupCode: \"G2\"\n    day: \"Wednesday\"\n    startTime: \"14:00\"\n    endTime: \"16:00\"\n    room: \"LAB-MFI-2\"\n    lecturer: \"Dr. Azman\"\n    semesterOffered: \"MARCH 2026\"\n  })\n  g3: scheduleGroup_insert(data: {\n    course: { code: \"FIB40104\" }\n    groupCode: \"G1\"\n    day: \"Tuesday\"\n    startTime: \"10:00\"\n    endTime: \"12:00\"\n    room: \"BLK A-301\"\n    lecturer: \"Dr. Lim\"\n    semesterOffered: \"MARCH 2026\"\n  })\n  g4: scheduleGroup_insert(data: {\n    course: { code: \"FPB49906\" }\n    groupCode: \"G1\"\n    day: \"Thursday\"\n    startTime: \"14:00\"\n    endTime: \"18:00\"\n    room: \"FYP Lab\"\n    lecturer: \"Dr. Yusman\"\n    semesterOffered: \"MARCH 2026\"\n  })\n  g5: scheduleGroup_insert(data: {\n    course: { code: \"MPU3242\" }\n    groupCode: \"G1\"\n    day: \"Friday\"\n    startTime: \"10:00\"\n    endTime: \"12:00\"\n    room: \"BLK E-101\"\n    lecturer: \"En. Hafiz\"\n    semesterOffered: \"MARCH 2026\"\n  })\n}\n\n# Step 4: Seed enrollment statuses (matches your study plan exactly)\nmutation SeedEnrollmentsCT @auth(level: PUBLIC) {\n  e1:  enrollment_insert(data: { student: { uid: \"vgA7UHMhF0boinz6BiUoKhCOYY93\" }, course: { code: \"FAB11203\" }, status: \"CT\", creditGained: 3 })\n  e2:  enrollment_insert(data: { student: { uid: \"vgA7UHMhF0boinz6BiUoKhCOYY93\" }, course: { code: \"FIB20103\" }, status: \"CT\", creditGained: 3 })\n  e3:  enrollment_insert(data: { student: { uid: \"vgA7UHMhF0boinz6BiUoKhCOYY93\" }, course: { code: \"FKB11102\" }, status: \"CT\", creditGained: 2 })\n  e4:  enrollment_insert(data: { student: { uid: \"vgA7U