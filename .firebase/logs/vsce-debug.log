[debug] [2026-06-15T17:26:42.961Z] >>> [apiv2][body] POST http://127.0.0.1:9399/v1/projects/unikl-planner-login-info/locations/asia-southeast1/services/uniklplanner:executeGraphql {"operationName":"DeleteAllScheduleGroups","variables":{},"query":"# ============================================================\n# SEED DATA — populates the database with your curriculum\n# Click \"Run (Local)\" above each mutation in order\n# ============================================================\n\n# Step 1: Create your student profile\nmutation SeedStudent @auth(level: PUBLIC) {\n  student_insert(data: {\n    uid: \"vgA7UHMhF0boinz6BiUoKhCOYY93\"\n    studentId: \"50222224092\"\n    name: \"MUHAMMAD NUR IRFAN BIN RAZILY\"\n    programme: \"Bachelor of Engineering Technology (Automation and Robotics) with Honours F22\"\n    intake: \"Sem 2023/2024-2\"\n    currentSemester: 9\n    totalCreditsRequired: 140\n    institute: \"UniKL Malaysia France Institute (MFI)\"\n    academicAdvisor: \"YUSMAN BIN YUSOF\"\n    email: \"irfan.razily@s.unikl.edu.my\"\n  })\n}\n\n# Step 2: Insert all 62 courses from the study plan\nmutation SeedAllCourses @auth(level: PUBLIC) {\n  # Year 1, Semester 1\n  c1:  course_insert(data: { code: \"FAB11203\", name: \"Automation Technology\",                  credits: 3, category: \"CORE\", year: 1, semester: 1 })\n  c2:  course_insert(data: { code: \"FIB20103\", name: \"Occupational Safety & Health\",           credits: 3, category: \"CORE\", year: 1, semester: 1 })\n  c3:  course_insert(data: { code: \"FKB11102\", name: \"Calculus 1\",                             credits: 2, category: \"CORE\", year: 1, semester: 1 })\n  c4:  course_insert(data: { code: \"FVB21602\", name: \"Engineering Ethics\",                     credits: 2, category: \"CORE\", year: 1, semester: 1 })\n  c5:  course_insert(data: { code: \"MPU3192\",  name: \"Philosophy and Current Issues\",          credits: 2, category: \"MPU\",  year: 1, semester: 1 })\n  c6:  course_insert(data: { code: \"WEB10302\", name: \"Fundamental English\",                    credits: 2, category: \"UCS\",  year: 1, semester: 1 })\n  c7:  course_insert(data: { code: \"WEB20202\", name: \"Professional English 1\",                 credits: 2, category: \"UCS\",  year: 1, semester: 1 })\n\n  # Year 1, Semester 2\n  c8:  course_insert(data: { code: \"FEB10203\", name: \"Electrical Principles\",                  credits: 3, category: \"CORE\", year: 1, semester: 2 })\n  c9:  course_insert(data: { code: \"FFB12503\", name: \"Engineering Drawing\",                    credits: 3, category: \"CORE\", year: 1, semester: 2 })\n  c10: course_insert(data: { code: \"FGB10303\", name: \"Workshop Practice\",                      credits: 3, category: \"CORE\", year: 1, semester: 2 })\n  c11: course_insert(data: { code: \"FMB11103\", name: \"Statics and Dynamics\",                   credits: 3, category: \"CORE\", year: 1, semester: 2 })\n  c12: course_insert(data: { code: \"FSB20103\", name: \"Basic Programming\",                      credits: 3, category: \"CORE\", year: 1, semester: 2 })\n  c13: course_insert(data: { code: \"MPU3142\",  name: \"Bahasa Melayu Komunikasi 2\",             credits: 2, category: \"MPU\",  year: 1, semester: 2 })\n  c14: course_insert(data: { code: \"MPU3182\",  name: \"Penghayatan Etika dan Peradaban\",        credits: 2, category: \"MPU\",  year: 1, semester: 2 })\n\n  # MPU34xx — pass ONE only (all optional)\n  c15: course_insert(data: { code: \"MPU34102\", name: \"Integriti & Anti-Rasuah 2\",              credits: 2, category: \"MPU\", year: 1, semester: 2, isOptional: true })\n  c16: course_insert(data: { code: \"MPU34112\", name: \"Huffaz Professional 2\",                  credits: 2, category: \"MPU\", year: 1, semester: 2, isOptional: true })\n  c17: course_insert(data: { code: \"MPU3412\",  name: \"Career Guidance 2\",                      credits: 2, category: \"MPU\", year: 1, semester: 2, isOptional: true })\n  c18: course_insert(data: { code: \"MPU3422\",  name: \"Community Service 2\",                    credits: 2, category: \"MPU\", year: 1, semester: 2, isOptional: true })\n  c19: course_insert(data: { code: \"MPU3432\",  name: \"Culture 2\",                              credits: 2, category: \"MPU\", year: 1, semester: 2, isOptional: true })\n  c20: course_insert(data: { code: \"MPU3442\",  name: \"Rakan Masjid 2\",                         credits: 2, category: \"MPU\", year: 1, semester: 2, isOptional: true })\n  c21: course_insert(data: { code: \"MPU3452\",  name: \"Siswa Siswi Bomba & Penyelamat 2\",       credits: 2, category: \"MPU\", year: 1, semester: 2, isOptional: true })\n  c22: course_insert(data: { code: \"MPU3462\",  name: \"Kor Siswa Pertahanan Awam 2\",            credits: 2, category: \"MPU\", year: 1, semester: 2, isOptional: true })\n  c23: course_insert(data: { code: \"MPU3472\",  name: \"Sports Management 2\",                    credits: 2, category: \"MPU\", year: 1, semester: 2, isOptional: true })\n  c24: course_insert(data: { code: \"MPU3482\",  name: \"Personal Financial Management 2\",        credits: 2, category: \"MPU\", year: 1, semester: 2, isOptional: true })\n  c25: course_insert(data: { code: \"MPU3492\",  name: \"Askar Wataniah\",                         credits: 2, category: \"MPU\", year: 1, semester: 2, isOptional: true })\n\n  # Year 2, Semester 3\n  c26: course_insert(data: { code: \"FKB22203\", name: \"Calculus 2\",                             credits: 3, category: \"CORE\", year: 2, semester: 3, prerequisite: \"FKB11102\" })\n  c27: course_insert(data: { code: \"FLB20103\", name: \"Analog and Digital Electronics\",         credits: 3, category: \"CORE\", year: 2, semester: 3 })\n  c28: course_insert(data: { code: \"FMB20403\", name: \"Computer Aided Design & Eng 1\",          credits: 3, category: \"CORE\", year: 2, semester: 3 })\n  c29: course_insert(data: { code: \"FTB12303\", name: \"Material Science\",                       credits: 3, category: \"CORE\", year: 2, semester: 3 })\n  c30: course_insert(data: { code: \"MPU3332\",  name: \"Isu-Isu Kontemporari Muslim\",            credits: 2, category: \"MPU\",  year: 2, semester: 3 })\n  c31: course_insert(data: { code: \"MPU3342\",  name: \"Culture & Lifestyle in Malaysia 2\",      credits: 2, category: \"MPU\",  year: 2, semester: 3 })\n  c32: course_insert(data: { code: \"WBB20103\", name: \"Technopreneurship\",                      credits: 3, category: \"CORE\", year: 2, semester: 3 })\n  c33: course_insert(data: { code: \"WEB20302\", name: \"Professional English 2\",                 credits: 2, category: \"UCS\",  year: 2, semester: 3, prerequisite: \"WEB20202\" })\n\n  # Year 2, Semester 4\n  c34: course_insert(data: { code: \"FAB30104\", name: \"Mechatronics System Design\",             credits: 4, category: \"CORE\", year: 2, semester: 4, prerequisite: \"FEB10203\" })\n  c35: course_insert(data: { code: \"FEB20303\", name: \"Electrical Machines\",                    credits: 3, category: \"CORE\", year: 2, semester: 4, prerequisite: \"FEB10203\" })\n  c36: course_insert(data: { code: \"FIB36103\", name: \"Project Management\",                     credits: 3, category: \"CORE\", year: 2, semester: 4 })\n  c37: course_insert(data: { code: \"FKB22303\", name: \"Statistics for Engineering Tech\",        credits: 3, category: \"CORE\", year: 2, semester: 4, prerequisite: \"FKB22203\" })\n  c38: course_insert(data: { code: \"FLB30603\", name: \"Electronic Design\",                      credits: 3, category: \"CORE\", year: 2, semester: 4, prerequisite: \"FLB20103\" })\n  c39: course_insert(data: { code: \"FMB20503\", name: \"Mechanics and Machine Design\",           credits: 3, category: \"CORE\", year: 2, semester: 4, prerequisite: \"FMB11103\" })\n\n  # Year 3, Semester 5\n  c40: course_insert(data: { code: \"FAB20204\", name: \"Programmable Logic Controller\",          credits: 4, category: \"CORE\", year: 3, semester: 5 })\n  c41: course_insert(data: { code: \"FAB20703\", name: \"Robotics\",                               credits: 3, category: \"CORE\", year: 3, semester: 5 })\n  c42: course_insert(data: { code: \"FAB35803\", name: \"Control Systems\",                        credits: 3, category: \"CORE\", year: 3, semester: 5 })\n  c43: course_insert(data: { code: \"FIB36403\", name: \"Production & Operation Management\",      credits: 3, category: \"CORE\", year: 3, semester: 5 })\n  c44: course_insert(data: { code: \"FSB30103\", name: \"Embedded System Technology\",             credits: 3, category: \"CORE\", year: 3, semester: 5, prerequisite: \"FSB20103\" })\n  c45: course_insert(data: { code: \"WFD10101\", name: \"French 1\",                               credits: 1, category: \"UCS\",  year: 3, semester: 5 })\n\n  # Year 3, Semester 6\n  c46: course_insert(data: { code: \"FIB30203\", name: \"Computer Integrated Manufacturing\",      credits: 3, category: \"CORE\", year: 3, semester: 6 })\n  c47: course_insert(data: { code: \"FLB35203\", name: \"Power Electronics and Drives\",           credits: 3, category: \"CORE\", year: 3, semester: 6, prerequisite: \"FLB20103\" })\n  c48: course_insert(data: { code: \"FPB49804\", name: \"Final Year Project 1\",                   credits: 4, category: \"FYP\",  year: 3, semester: 6 })\n  c49: course_insert(data: { code: \"FSB40103\", name: \"Internet of Things & Data Analytics\",    credits: 3, category: \"CORE\", year: 3, semester: 6, prerequisite: \"FSB20103\" })\n  c50: course_insert(data: { code: \"WFD10201\", name: \"French 2\",                               credits: 1, category: \"UCS\",  year: 3, semester: 6, prerequisite: \"WFD10101\" })\n\n  # Year 4, Semester 7\n  c51: course_insert(data: { code: \"FAB30303\", name: \"Mobile Robotics\",                        credits: 3, category: \"CORE\", year: 4, semester: 7, prerequisite: \"FAB20703\" })\n  c52: course_insert(data: { code: \"FIB40104\", name: \"Flexible Manufacturing System\",          credits: 4, category: \"CORE\", y