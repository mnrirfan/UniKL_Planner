ditGained: 3, semesterTaken: \"MARCH 2025\" })\n  p12: enrollment_insert(data: { student: { uid: \"vgA7UHMhF0boinz6BiUoKhCOYY93\" }, course: { code: \"FLB30603\" }, status: \"PASS\", creditGained: 3, semesterTaken: \"OCTOBER 2024\" })\n  p13: enrollment_insert(data: { student: { uid: \"vgA7UHMhF0boinz6BiUoKhCOYY93\" }, course: { code: \"FMB20503\" }, status: \"PASS\", creditGained: 3, semesterTaken: \"MARCH 2025\" })\n  p14: enrollment_insert(data: { student: { uid: \"vgA7UHMhF0boinz6BiUoKhCOYY93\" }, course: { code: \"FAB20204\" }, status: \"PASS\", creditGained: 4, semesterTaken: \"MARCH 2025\" })\n  p15: enrollment_insert(data: { student: { uid: \"vgA7UHMhF0boinz6BiUoKhCOYY93\" }, course: { code: \"FIB36403\" }, status: \"PASS\", creditGained: 3, semesterTaken: \"MARCH 2024\" })\n  p16: enrollment_insert(data: { student: { uid: \"vgA7UHMhF0boinz6BiUoKhCOYY93\" }, course: { code: \"FSB30103\" }, status: \"PASS\", creditGained: 3, semesterTaken: \"OCTOBER 2025\" })\n  p17: enrollment_insert(data: { student: { uid: \"vgA7UHMhF0boinz6BiUoKhCOYY93\" }, course: { code: \"WFD10101\" }, status: \"PASS\", creditGained: 1, semesterTaken: \"OCTOBER 2025\" })\n  p18: enrollment_insert(data: { student: { uid: \"vgA7UHMhF0boinz6BiUoKhCOYY93\" }, course: { code: \"FIB30203\" }, status: \"PASS\", creditGained: 3, semesterTaken: \"OCTOBER 2025\" })\n  p19: enrollment_insert(data: { student: { uid: \"vgA7UHMhF0boinz6BiUoKhCOYY93\" }, course: { code: \"FLB35203\" }, status: \"PASS\", creditGained: 3, semesterTaken: \"OCTOBER 2025\" })\n  p20: enrollment_insert(data: { student: { uid: \"vgA7UHMhF0boinz6BiUoKhCOYY93\" }, course: { code: \"FPB49804\" }, status: \"PASS\", creditGained: 4, semesterTaken: \"OCTOBER 2024\" })\n  p21: enrollment_insert(data: { student: { uid: \"vgA7UHMhF0boinz6BiUoKhCOYY93\" }, course: { code: \"FSB40103\" }, status: \"PASS\", creditGained: 3, semesterTaken: \"MARCH 2026\" })\n  p22: enrollment_insert(data: { student: { uid: \"vgA7UHMhF0boinz6BiUoKhCOYY93\" }, course: { code: \"WFD10201\" }, status: \"PASS\", creditGained: 1, semesterTaken: \"MARCH 2026\" })\n  p23: enrollment_insert(data: { student: { uid: \"vgA7UHMhF0boinz6BiUoKhCOYY93\" }, course: { code: \"FIB42003\" }, status: \"PASS\", creditGained: 3, semesterTaken: \"MARCH 2024\" })\n  p24: enrollment_insert(data: { student: { uid: \"vgA7UHMhF0boinz6BiUoKhCOYY93\" }, course: { code: \"FIB42103\" }, status: \"PASS\", creditGained: 3, semesterTaken: \"OCTOBER 2025\" })\n}\n\n# Currently taking (ST) — sem 9\nmutation SeedEnrollmentsST @auth(level: PUBLIC) {\n  s1: enrollment_insert(data: { student: { uid: \"vgA7UHMhF0boinz6BiUoKhCOYY93\" }, course: { code: \"FAB30303\" }, status: \"ST\", semesterTaken: \"MARCH 2026\" })\n  s2: enrollment_insert(data: { student: { uid: \"vgA7UHMhF0boinz6BiUoKhCOYY93\" }, course: { code: \"FIB40104\" }, status: \"ST\", semesterTaken: \"MARCH 2026\" })\n  s3: enrollment_insert(data: { student: { uid: \"vgA7UHMhF0boinz6BiUoKhCOYY93\" }, course: { code: \"FPB49906\" }, status: \"ST\", semesterTaken: \"MARCH 2026\" })\n  s4: enrollment_insert(data: { student: { uid: \"vgA7UHMhF0boinz6BiUoKhCOYY93\" }, course: { code: \"MPU3242\" },  status: \"ST\", semesterTaken: \"MARCH 2026\" })\n  s5: enrollment_insert(data: { student: { uid: \"vgA7UHMhF0boinz6BiUoKhCOYY93\" }, course: { code: \"WIB41012\" }, status: \"ST\", semesterTaken: \"OCTOBER 2026\" })\n}","extensions":{}}
