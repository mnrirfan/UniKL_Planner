eedScheduleGroups @auth(level: PUBLIC) {\n  g1: scheduleGroup_insert(data: {\n    course: { code: \"FAB30303\" }\n    groupCode: \"G1\"\n    day: \"Monday\"\n    startTime: \"08:00\"\n    endTime: \"10:00\"\n    room: \"LAB-MFI-1\"\n    lecturer: \"Dr. Azman\"\n    semesterOffered: \"MARCH 2026\"\n  })\n  g2: scheduleGroup_insert(data: {\n    course: { code: \"FAB30303\" }\n    groupCode: \"G2\"\n    day: \"Wednesday\"\n    startTime: \"14:00\"\n    endTime: \"16:00\"\n    room: \"LAB-MFI-2\"\n    lecturer: \"Dr. Azman\"\n    semesterOffered: \"MARCH 2026\"\n  })\n  g3: scheduleGroup_insert(data: {\n    course: { code: \"FIB40104\" }\n    groupCode: \"G1\"\n    day: \"Tuesday\"\n    startTime: \"10:00\"\n    endTime: \"12:00\"\n    room: \"BLK A-301\"\n    lecturer: \"Dr. Lim\"\n    semesterOffered: \"MARCH 2026\"\n  })\n  g4: scheduleGroup_insert(data: {\n    course: { code: \"FPB49906\" }\n    groupCode: \"G1\"\n    day: \"Thursday\"\n    startTime: \"14:00\"\n    endTime: \"18:00\"\n    room: \"FYP Lab\"\n    lecturer: \"Dr. Yusman\"\n    semesterOffered: \"MARCH 2026\"\n  })\n  g5: scheduleGroup_insert(data: {\n    course: { code: \"MPU3242\" }\n    groupCode: \"G1\"\n    day: \"Friday\"\n    startTime: \"10:00\"\n    endTime: \"12:00\"\n    room: \"BLK E-101\"\n    lecturer: \"En. Hafiz\"\n    semesterOffered: \"MARCH 2026\"\n  })\n}\n\n# Step 4: Seed enrollment statuses (matches your study plan exactly)\nmutation SeedEnrollmentsCT @auth(level: PUBLIC) {\n  e1:  enrollment_insert(data: { student: { uid: \"vgA7UHMhF0boinz6BiUoKhCOYY93\" }, course: { code: \"FAB11203\" }, status: \"CT\", creditGained: 3 })\n  e2:  enrollment_insert(data: { student: { uid: \"vgA7UHMhF0boinz6BiUoKhCOYY93\" }, course: { code: \"FIB20103\" }, status: \"CT\", creditGained: 3 })\n  e3:  enrollment_insert(data: { student: { uid: \"vgA7UHMhF0boinz6BiUoKhCOYY93\" }, course: { code: \"FKB11102\" }, status: \"CT\", creditGained: 2 })\n  e4:  enrollment_insert(data: { student: { uid: \"vgA7UHMhF0boinz6BiUoKhCOYY93\" }, course: { code: \"FVB21602\" }, status: \"CT\", creditGained: 2 })\n  e5:  enrollment_insert(data: { student: { uid: \"vgA7UHMhF0boinz6BiUoKhCOYY93\" }, course: { code: \"WEB20202\" }, status: \"CT\", creditGained: 2 })\n  e6:  enrollment_insert(data: { student: { uid: \"vgA7UHMhF0boinz6BiUoKhCOYY93\" }, course: { code: \"FFB12503\" }, status: \"CT\", creditGained: 3 })\n  e7:  enrollment_insert(data: { student: { uid: \"vgA7UHMhF0boinz6BiUoKhCOYY93\" }, course: { code: \"FGB10303\" }, status: \"CT\", creditGained: 3 })\n  e8:  enrollment_insert(data: { student: { uid: \"vgA7UHMhF0boinz6BiUoKhCOYY93\" }, course: { code: \"FMB11103\" }, status: \"CT\", creditGained: 3 })\n  e9:  enrollment_insert(data: { student: { uid: \"vgA7UHMhF0boinz6BiUoKhCOYY93\" }, course: { code: \"FSB20103\" }, status: \"CT\", creditGained: 3 })\n  e10: enrollment_insert(data: { student: { uid: \"vgA7UHMhF0boinz6BiUoKhCOYY93\" }, course: { code: \"FMB20403\" }, status: \"CT\", creditGained: 3 })\n  e11: enrollment_insert(data: { student: { uid: \"vgA7UHMhF0boinz6BiUoKhCOYY93\" }, course: { code: \"FTB12303\" }, status: \"CT\", creditGained: 3 })\n  e12: enrollment_insert(data: { student: { uid: \"vgA7UHMhF0boinz6BiUoKhCOYY93\" }, course: { code: \"WBB20103\" }, status: \"CT\", creditGained: 3 })\n  e13: enrollment_insert(data: { student: { uid: \"vgA7UHMhF0boinz6BiUoKhCOYY93\" }, course: { code: \"FAB30104\" }, status: \"CT\", creditGained: 4 })\n  e14: enrollment_insert(data: { student: { uid: \"vgA7UHMhF0boinz6BiUoKhCOYY93\" }, course: { code: \"FIB36103\" }, status: \"CT\", creditGained: 3 })\n  e15: enrollment_insert(data: { student: { uid: \"vgA7UHMhF0boinz6BiUoKhCOYY93\" }, course: { code: \"FAB20703\" }, status: \"CT\", creditGained: 3 })\n  e16: enrollment_insert(data: { student: { uid: \"vgA7UHMhF0boinz6BiUoKhCOYY93\" }, course: { code: \"FAB35803\" }, status: \"CT\", creditGained: 3 })\n}\n\nmutation SeedEnrollmentsPASS @auth(level: PUBLIC) {\n  p1:  enrollment_insert(data: { student: { uid: \"vgA7UHMhF0boinz6BiUoKhCOYY93\" }, course: { code: \"MPU3192\" },  status: \"PASS\", creditGained: 2, semesterTaken: \"MARCH 2024\" })\n  p2:  enrollment_insert(data: { student: { uid: \"vgA7UHMhF0boinz6BiUoKhCOYY93\" }, course: { code: \"WEB10302\" }, status: \"PASS\", creditGained: 2, semesterTaken: \"MARCH 2024\" })\n  p3:  enrollment_insert(data: { student: { uid: \"vgA7UHMhF0boinz6BiUoKhCOYY93\" }, course: { code: \"FEB10203\" }, status: \"PASS\", creditGained: 3, semesterTaken: \"MARCH 2024\" })\n  p4:  enrollment_insert(data: { student: { uid: \"vgA7UHMhF0boinz6BiUoKhCOYY93\" }, course: { code: \"MPU3182\" },  status: \"PASS\", creditGained: 2, semesterTaken: \"OCTOBER 2024\" })\n  p5:  enrollment_insert(data: { student: { uid: \"vgA7UHMhF0boinz6BiUoKhCOYY93\" }, course: { code: \"MPU3422\" },  status: \"PASS\", creditGained: 2, semesterTaken: \"OCTOBER 2024\" })\n  p6:  enrollment_insert(data: { student: { uid: \"vgA7UHMhF0boinz6BiUoKhCOYY93\" }, course: { code: \"FKB22203\" }, status: \"PASS\", creditGained: 3, semesterTaken: \"OCTOBER 2024\" })\n  p7:  enrollment_insert(data: { student: { uid: \"vgA7UHMhF0boinz6BiUoKhCOYY93\" }, course: { code: \"FLB20103\" }, status: \"PASS\", creditGained: 3, semesterTaken: \"OCTOBER 2024\" })\n  p8:  enrollment_insert(data: { student: { uid: \"vgA7UHMhF0boinz6BiUoKhCOYY93\" }, course: { code: \"MPU3332\" },  status: \"PASS\", creditGained: 2, semesterTaken: \"OCTOBER 2024\" })\n  p9:  enrollment_insert(data: { student: { uid: \"vgA7UHMhF0boinz6BiUoKhCOYY93\" }, course: { code: \"WEB20302\" }, status: \"PASS\", creditGained: 2, semesterTaken: \"OCTOBER 2024\" })\n  p10: enrollment_insert(data: { student: { uid: \"vgA7UHMhF0boinz6BiUoKhCOYY93\" }, course: { code: \"FEB20303\" }, status: \"PASS\", creditGained: 3, semesterTaken: \"JULY 2025\" })\n  p11: enrollment_insert(data: { student: { uid: \"vgA7UHMhF0boinz6BiUoKhCOYY93\" }, course: { code: \"FKB22303\" }, status: \"PASS\", creditGained: 3, semesterTaken: \"MARCH 2025\" })\n  p12: enrollment_insert(data: { student: { uid: \"vgA7UHMhF0boinz6BiUoKhCOYY93\" }, course: { code: \"FLB30603\" }, status: \"PASS\", creditGained: 3, semesterTaken: \"OCTOBER 2024\" })\n  p13: enrollment_insert(data: { student: { uid: \"vgA7UHMhF0boinz6BiUoKhCOYY93\" }, course: { code: \"FMB20503\" }, status: \"PASS\", creditGained: 3, semesterTaken: \"MARCH 2025\" })\n  p14: enrollment_insert(data: { student: { uid: \"vgA7UHMhF0boinz6BiUoKhCOYY93\" }, course: { code: \"FAB20204\" }, status: \"PASS\", creditGained: 4, semesterTaken: \"MARCH 2025\" })\n  p15: enrollment_insert(data: { student: { uid: \"vgA7UHMhF0boinz6BiUoKhCOYY93\" }, course: { code: \"FIB36403\" }, status: \"PASS\", creditGained: 3, semesterTaken: \"MARCH 2024\" })\n  p16: enrollment_insert(data: { student: { uid: \"vgA7UHMhF0boinz6BiUoKhCOYY93\" }, course: { code: \"FSB30103\" }, status: \"PASS\", creditGained: 3, semesterTaken: \"OCTOBER 2025\" })\n  p17: enrollment_insert(data: { student: { uid: \"vgA7UHMhF0boinz6BiUoKhCOYY93\" }, course: { code: \"WFD10101\" }, status: \"PASS\", creditGained: 1, semesterTaken: \"OCTOBER 2025\" })\n  p18: enrollment_insert(data: { student: { uid: \"vgA7UHMhF0boinz6BiUoKhCOYY93\" }, course: { code: \"FIB30203\" }, status: \"PASS\", creditGained: 3, semesterTaken: \"OCTOBER 2025\" })\n  p19: enrollment_insert(data: { student: { uid: \"vgA7UHMhF0boinz6BiUoKhCOYY93\" }, course: { code: \"FLB35203\" }, status: \"PASS\", creditGained: 3, semesterTaken: \"OCTOBER 2025\" })\n  p20: enrollment_insert(data: { student: { uid: \"vgA7UHMhF0boinz6BiUoKhCOYY93\" }, course: { code: \"FPB49804\" }, status: \"PASS\", creditGained: 4, semesterTaken: \"OCTOBER 2024\" })\n  p21: enrollment_insert(data: { student: { uid: \"vgA7UHMhF0boinz6BiUoKhCOYY93\" }, course: { code: \"FSB40103\" }, status: \"PASS\", creditGained: 3, semesterTaken: \"MARCH 2026\" })\n  p22: enrollment_insert(data: { student: { uid: \"vgA7UHMhF0boinz6BiUoKhCOYY93\" }, course: { code: \"WFD10201\" }, status: \"PASS\", creditGained: 1, semesterTaken: \"MARCH 2026\" })\n  p23: enrollment_insert(data: { student: { uid: \"vgA7UHMhF0boinz6BiUoKhCOYY93\" }, course: { code: \"FIB42003\" }, status: \"PASS\", creditGained: 3, semesterTaken: \"MARCH 2024\" })\n  p24: enrollment_insert(data: { student: { uid: \"vgA7UHMhF0boinz6BiUoKhCOYY93\" }, course: { code: \"FIB42103\" }, status: \"PASS\", creditGained: 3, semesterTaken: \"OCTOBER 2025\" })\n}\n\n# Currently taking (ST) — sem 9\nmutation SeedEnrollmentsST @auth(level: PUBLIC) {\n  s1: enrollment_insert(data: { student: { uid: \"vgA7UHMhF0boinz6BiUoKhCOYY93\" }, course: { code: \"FAB30303\" }, status: \"ST\", semesterTaken: \"MARCH 2026\" })\n  s2: enrollment_insert(data: { student: { uid: \"vgA7UHMhF0boinz6BiUoKhCOYY93\" }, course: { code: \"FIB40104\" }, status: \"ST\", semesterTaken: \"MARCH 2026\" })\n  s3: enrollment_insert(data: { student: { uid: \"vgA7UHMhF0boinz6BiUoKhCOYY93\" }, course: { code: \"FPB49906\" }, status: \"ST\", semesterTaken: \"MARCH 2026\" })\n  s4: enrollment_insert(data: { student: { uid: \"vgA7UHMhF0boinz6BiUoKhCOYY93\" }, course: { code: \"MPU3242\" },  status: \"ST\", semesterTaken: \"MARCH 2026\" })\n  s5: enrollment_insert(data: { student: { uid: \"vgA7UHMhF0boinz6BiUoKhCOYY93\" }, course: { code: \"WIB41012\" }, status: \"ST\", semesterTaken: \"OCTOBER 2026\" })\n}","extensions":{}}
